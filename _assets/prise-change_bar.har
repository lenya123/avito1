            "text": "{\"result\":{\"navigation\":{\"attributes\":[{\"id\":178,\"value\":759},{\"id\":110,\"value\":403},{\"id\":166252,\"value\":3268185}],\"categoryId\":29,\"categoryIds\":[29],\"config\":{\"branch\":\"latest\",\"layout\":\"mav_edit\",\"tree\":\"mav\"},\"microcategoryId\":2179580},\"params\":[{\"id\":166252,\"title\":\"Вид одежды\",\"displayTitle\":\"Джинсы\",\"type\":\"select\",\"required\":true,\"immutable\":false,\"widget\":{\"type\":\"select\"},\"isRange\":false,\"constraints\":[{\"type\":\"required\",\"value\":{\"tag\":\"166252:enumerable:required\",\"message\":\"Укажите значение параметра\",\"passOnMatch\":false,\"severity\":\"error\"}}],\"value\":\"3268185\",\"values\":[{\"id\":\"3268185\",\"title\":\"Джинсы\"},{\"id\":\"3268184\",\"title\":\"Брюки\"},{\"id\":\"3268186\",\"title\":\"Шорты\"}],\"hasSuggest\":false,\"updatesForm\":true},{\"id\":196926,\"title\":\"Исходный размер просто скидки\",\"type\":\"int\",\"immutable\":false,\"widget\":{\"type\":\"hidden\"},\"isRange\":false,\"updatesForm\":false},{\"id\":2827,\"title\":\"Вид объявления\",\"displayTitle\":\"Продаю своё\",\"type\":\"select\",\"required\":true,\"immutable\":false,\"widget\":{\"type\":\"select\",\"config\":{\"size\":\"m\"}},\"placeholder\":\"Выбрать\",\"isRange\":false,\"constraints\":[{\"type\":\"required\",\"value\":{\"tag\":\"2827:enumerable:required\",\"message\":\"Выберите значение из списка\",\"passOnMatch\":false,\"severity\":\"error\"}}],\"value\":\"20032\",\"values\":[{\"id\":\"20032\",\"title\":\"Продаю своё\"},{\"id\":\"20033\",\"title\":\"Товар приобретён на продажу\"},{\"id\":\"20034\",\"title\":\"Товар от производителя\"}],\"hasSuggest\":false,\"updatesForm\":true},{\"id\":100001,\"title\":\"Название объявления\",\"type\":\"char\",\"required\":true,\"immutable\":false,\"widget\":{\"type\":\"input\",\"config\":{\"constraints\":[{\"type\":\"regexp\",\"value\":{\"message\":\"Не пишите в названии цену, для этого есть отдельное поле.\",\"passOnMatch\":false,\"regexp\":\"(^|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)[0-9]{3,}\\\\s*[\\\\$\\\\€\\\\¥]|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+(руб|рублей|₽)($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:price_app\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим правилам нельзя размещать объявления о покупке. Ищите интересующие вас товары в поиске.\",\"passOnMatch\":false,\"regexp\":\"(^|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)куплю($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:purchase\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим правилам нельзя писать в названии: скидка, акция, дёшево, срочно и т. д. Привлекайте внимание к объявлению подробным описанием и чёткими фотографиями.\",\"passOnMatch\":false,\"regexp\":\"(^|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)(срочно|внимание|даром|торопитесь|выгодно)($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:attention\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим правилам нельзя указывать телефоны, ссылки и эл. почту в названии.\",\"passOnMatch\":false,\"regexp\":\"(^|[^\\\\d-])((8|\\\\+?7)[ .-]?)?\\\\(?9\\\\d{2}\\\\)?[ .-]?([ .-]?\\\\d[ .-]?){7}\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:phone\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим правилам нельзя указывать телефоны, ссылки и эл. почту в названии.\",\"passOnMatch\":false,\"regexp\":\"(((ht|f)tp(s?))\\\\:\\\\/\\\\/|www\\\\.|file\\\\:\\\\/\\\\/)+[\\\\w\\\\.\\\\-]+\\\\.[a-z]{2,4}(\\\\/[\\\\w\\\\/\\\\.\\\\-\\\\.\\\\?\\\\,\\\\'\\\\/\\\\\\\\+\\u0026amp;%\\\\$#\\\\=~]*|($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+))\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:link\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим правилам нельзя указывать телефоны, ссылки и эл. почту в названии.\",\"passOnMatch\":false,\"regexp\":\"[a-z]+[\\\\.\\\\-a-z0-9_]*[ ]*@[ ]*[\\\\.\\\\-a-z0-9_]*[ ]*\\\\.