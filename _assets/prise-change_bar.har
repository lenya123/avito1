%D0%B5%D0%B4%D0%BB%D0%BE%D0%B6%D0%B5%D0%BD%D0%B8%D0%B5.%20%D0%A3%D1%81%D0%BB%D1%83%D0%B3%D0%B0%20%D0%B1%D0%B5%D1%81%D0%BF%D0%BB%D0%B0%D1%82%D0%BD%D0%B0.%22%7D%2C%22button%22%3A%7B%22title%22%3A%22%D0%A5%D0%BE%D1%80%D0%BE%D1%88%D0%BE%22%2C%22style%22%3A%22secondary%22%7D%7D\"}}},\"text\":\"{{detailsLink}}\"},\"title\":\"Опубликовать заново, когда закончится срок размещения\",\"type\":\"boolean\"},\"size\":\"m\"}},\"value\":{\"autoPublish\":false}},{\"id\":13213589,\"type\":\"slot\",\"label\":\"Несколько штук в наличии\",\"widget\":{\"type\":\"stockManagement\",\"config\":{\"inputField\":{\"constraints\":{\"max\":{\"message\":\"Укажите число до 1 000 000\",\"value\":999999}},\"displaying\":{\"hideTitle\":true,\"postfix\":\"шт.\"},\"hint\":\"Количество можно не указывать\",\"label\":\"Количество\",\"placeholder\":\"Количество\",\"type\":\"quantity\"},\"size\":\"m\",\"switcherField\":{\"label\":\"Несколько штук в наличии\",\"linkTitle\":\"Как это работает\",\"tooltip\":{\"content\":[{\"content\":\"Покупатели увидят, что вы продаёте несколько штук, упаковок или других единиц товара — и смогут купить больше одной.\",\"title\":\"В объявлении появится отметка о количестве\"},{\"content\":\"Если она будет доступна и вы её включите, то сразу несколько человек смогут оформить заказ.\\n\\n А если укажете точное количество товара, мы поможем не набрать лишних заказов: когда запасы закончатся, снимем объявление с публикации или уберём из него кнопки «Купить с доставкой» и «Добавить в корзину».\",\"title\":\"Как это работает с Авито Доставкой\"}],\"title\":\"В объявлении появится отметка о количестве\"}}}},\"value\":{\"stockMultiple\":false}},{\"id\":13213737,\"type\":\"slot\",\"label\":\"inAppCallsDevices\",\"widget\":{\"type\":\"inAppCallsDevices\",\"config\":{\"iacDevices\":[],\"iacForPro\":false,\"iacProUser\":false}},\"value\":{\"iacDevices\":[\"2CE28A1D-3647-4484-AFAA-71F3A4E4C0B5\"],\"iacProChosen\":false}}],\"rootNavigation\":{},\"shouldSaveDraft\":false,\"steps\":[{\"conf