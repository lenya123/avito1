DeeplinkBlock_1.0.6\",\"contentPadding\":{\"bottom\":40,\"end\":40,\"start\":40,\"top\":36},\"cornerRadius\":32,\"layoutPadding\":{\"bottom\":12,\"end\":0,\"start\":0,\"top\":28},\"layout_visible\":\"{{_elements.1560809.visible}}\",\"text\":\"Соблюдайте их в будущем, иначе можем на время ограничить доставку или чаты и звонки.\",\"title\":\"В заказе есть нарушения правил Авито Доставки\",\"visible\":\"{{_elements.1560809.visible}}\"},{\"componentType\":\"orderRecommendationBlock_1.1.13\",\"isDesktop\":\"{{params.isDesktop}}\",\"layout_visible\":\"{{_elements.1560810.visible}}\",\"platform\":{\"functionType\":\"StructureGet\",\"key\":\"platform\",\"structure\":\"{{params}}\"},\"tag\":\"orderRecommendationBlock\",\"visible\":\"{{_elements.1560810.visible}}\"},{\"componentType\":\"orderRecommendationBlockV2_1.0.34\",\"isDesktop\":\"{{params.isDesktop}}\",\"layout_visible\":\"{{_elements.1560811.visible}}\",\"platform\":{\"functionType\":\"StructureGet\",\"key\":\"platform\",\"structure\":\"{{params}}\"},\"tag\":\"orderRecommendationBlock\",\"visible\":\"{{_elements.1560811.visible}}\"},{\"claims\":\"{{_sources.68666.claims}}\",\"componentType\":\"orderClaimsBlock_1.1.9\",\"isDesktop\":\"{{params.isDesktop}}\",\"layout_visible\":\"{{_elements.1560812.visible}}\",\"visible\":\"{{_elements.1560812.visible}}\"},{\"componentType\":\"orderSellerCombinedBlock_1.0.0\",\"isDesktop\":\"{{params.isDesktop}}\",\"layout_visible\":\"{{_elements.1560813.visible}}\",\"visible\":\"{{_elements.1560813.visible}}\"},{\"componentType\":\"verticalSpacing_1.0.0\",\"desktopSpacing\":12,\"isDesktop\":\"{{params.isDesktop}}\",\"layout_visible\":\"{{_elements.1560814.visible}}\",\"spacing\":32,\"visible\":\"{{_elements.1560814.visible}}\"},{\"componentType\":\"orderPassportReminderBlock_1.0.0\",\"isDesktop\":\"{{params.isDesktop}}\",\"layout_visible\":\"{{_elements.1560815.visible}}\",\"visible\":\"{{_elements.1560815.visible}}\"},{\"componentType\":\"verticalSpacing_1.0.0\",\"desktopSpacing\":12,\"isDesktop\":\"{{params.isDesktop}}\",\"layout_visible\":\"{{_elements.1560816.visible}}\",\"spacing\":32,\"visible\":\"{{_elements.1560816.visible}}\"},{\"componentType\":\"orderItems_1.2.0\",\"hideMessengerButton\":{\"functionType\":\"StructureGet\",\"key\":\"isChatHidden\",\"structure\":\"{{params}}\"},\"isDesktop\":\"{{params.isDesktop}}\",\"items\":\"{{params.items}}\",\"layout_visible\":true,\"title\":\"Заказ\",\"visible\":true},{\"componentType\":\"verticalSpacing_1.0.0\",\"desktopSpacing\":12,\"isDesktop\":\"{{params.isDesktop}}\",\"layout_visible\":true,\"spacing\":32,\"visible\":true},{\"componentType\":\"orderPriceBlock_1.5.0\",\"isDesktop\":\"{{params.isDesktop}}\",\"layout_visible\":true,\"priceBlock\":\"{{_sources.68665.priceBlock}}\",\"visible\":true},{\"componentType\":\"verticalSpacing_1.0.0\",\"desktopSpacing\":36,\"isDesktop\":\"{{params.isDesktop}}\",\"layout_visible\":true,\"spacing\":32,\"visible\":true},{\"children\":[{\"componentType\":\"accordion_1.0.1\",\"contentChildren\":[{\"componentType\":\"text_1.0.0\",\"layoutPadding\":{\"bottom\":12},\"layout_visible\":true,\"styleName\":\"textS10\",\"text\":\"Бесплатно выдадут коробку до 33 × 25 × 15 см, пакет А4 или А3. Если заказ не влезет, вы сможете купить упаковку большего размера прямо на месте.\",\"visible\":true},{\"componentType\":\"text_1.0.0\",\"layout_visible\":true,\"styleName\":\"textS10\",\"text\":\"Напоминаем, что СДЭК принимает заказы весом до 25 кг. Все стороны посылки должны быть меньше 149 см, а произведение длины, ширины и высоты не должно превышать 125 000 .\",\"visible\":true}],\"layout_visible\":\"{{_elements.1560823.visible}}\",\"style\":\"accordionH50\",\"titleItems\":[{\"value\":\"В пункте есть бесплатная и платная упаковка\"}],\"visible\":\"{{_elements.1560823.visible}}\"},{\"componentType\":\"accordion_1.0.1\",\"contentChildren\":[{\"componentType\":\"text_1.0.0\",\"layoutPadding\":{\"bottom\":12},\"layout_visible\":true,\"styleName\":\"textS10\",\"text\":\"В них помещаются товары размером до 44,5 × 60 см. Если ваш заказ больше, упакуйте его в пакет или коробку заранее. Купить более вместительную упаковку на месте не получится.\",\"visible\":true},{\"componentType\":\"text_1.0.0\",\"layout_visible\":true,\"styleName\":\"textS10\",\"text\":\"Напоминаем, что DPD принимает заказы весом до 20 кг. Все стороны посылки должны быть меньше 120 см, а сумма длины, ширины и высоты не должна превышать 200 см.\",\"visible\":true}],\"layout_visible\":\"{{_elements.1560827.visible}}\",\"style\":\"accordionH50\",\"titleItems\":[{\"value\":\"В пункте есть бесплатные сейф-пакеты\"}],\"visible\":\"{{_elements.1560827.visible}}\"},{\"componentType\":\"accordion_1.0.1\",\"contentChildren\":[{\"componentType\":\"text_1.0.0\",\"layoutPadding\":{\"bottom\":12},\"layout_visible\":true,\"styleName\":\"textS10\",\"text\":\"Сфотографируйте его с разных ракурсов и при хорошем освещении. Фото пригодятся в случае спорной ситуации — на них должно быть видно товар целиком и детали, которые помогут его опознать. Например, бренд, серийный номер или бирку.\",\"visible\":true},{\"componentType\":\"orderRichText_1.1.3\",\"isDesktop\":\"{{params.isDesktop}}\",\"layout_visible\":true,\"orderId\":\"{{params.referenceID}}\",\"padding\":{\"mobileLeftPadding\":0,\"mobileRightPadding\":0,\"webLeftPadding\":0,\"webRightPadding\":0},\"segments\":[{\"strikethrough\":false,\"underline\":false,\"value\":\"Затем оберните товар в бумагу или плёнку с пузырьками и положите в пакет или коробку. Не запечатывайте посылку полностью: \"},{\"strikethrough\":false,\"underline\":false,\"value\":\"{{_state.servicePlace}}\"},{\"strikethrough\":false,\"underline\":false,\"value\":\" её могут проверить.\"}],\"textStyle\":\"textS10\",\"visible\":true},{\"componentType\":\"verticalSpacing_1.0.0\",\"desktopSpacing\":12,\"isDesktop\":\"{{params.isDesktop}}\",\"layout_visible\":true,\"spacing\":12,\"visible\":true},{\"componentType\":\"orderRichText_1.1.3\",\"isDesktop\":\"{{params.isDesktop}}\",\"layout_visible\":true,\"orderId\":\"{{params.referenceID}}\",\"padding\":{\"mobileLeftPadding\":0,\"mobileRightPadding\":0,\"webLeftPadding\":0,\"webRightPadding\":0},\"segments\":[{\"strikethrough\":false,\"underline\":false,\"value\":\"На всякий случай сделайте фото или снимите товар на видео прямо \"},{\"strikethrough\":false,\"underline\":false,\"value\":\"{{_state.servicePlaceShort}}\"},{\"strikethrough\":false,\"underline\":false,\"value\":\", а также сфотографируйте штрихкод, который наклеят на посылку.\"}],\"textStyle\":\"textS10\",\"visible\":true}],\"layout_visible\":\"{{_elements.1560831.visible}}\",\"style\":\"accordionH50\",\"titleItems\":[{\"value\":\"Как подготовить товар к отправке\"}],\"visible\":\"{{_elements.1560831.visible}}\"},{\"componentType\":\"text_1.0.0\",\"layout_visible\":false,\"styleName\":\"textH50\",\"text\":\"На ПВЗ есть бесплатная упаковка - 3 вида коробок для посылок: S - 25 х 15 х 10, M - 35 х 25 х 15, L - 45 х 30 х 20. Товары должны помещаться в один из размеров и весить не более 12 кг.\",\"visible\":false},{\"componentType\":\"accordion_1.0.1\",\"contentChildren\":[{\"componentType\":\"text_1.0.0\",\"layout_visible\":true,\"styleName\":\"textS10\",\"text\":\"3 вида коробок для посылок: S - 25 х 15 х 10, M - 35 х 25 х 15, L - 45 х 30 х 20. Товары должны помещаться в один из размеров и весить не более 12 кг.\",\"visible\":true}],\"layout_visible\":\"{{_elements.1560838.visible}}\",\"style\":\"accordionH50\",\"titleItems\":[{\"value\":\"На ПВЗ есть бесплатная упаковка\"}],\"visible\":\"{{_elements.1560838.visible}}\"},{\"componentType\":\"accordion_1.0.1\",\"contentChildren\":[{\"componentType\":\"orderRichText_1.1.3\",\"isDesktop\":\"{{params.isDesktop}}\",\"layout_visible\":true,\"orderId\":\"{{params.referenceID}}\",\"padding\":{\"mobileLeftPadding\":0,\"mobileRightPadding\":0,\"webLeftPadding\":0,\"webRightPadding\":0},\"segments\":[{\"strikethrough\":false,\"underline\":false,\"value\":\"Когда покупатель примет посылку, можно будет выбрать способ получения оплаты. \"},{\"strikethrough\":false,\"underline\":false,\"value\":\"Банк переведёт вам \"},{\"strikethrough\":false,\"underline\":false,\"value\":\"{{_sources.68665.priceBlock.totalPrice}}\"},{\"strikethrough\":false,\"underline\":false,\"value\":\".\"}],\"textStyle\":\"textS10\",\"visible\":true}],\"layout_visible\":\"{{_elements.1560841.visible}}\",\"style\":\"accordionH50\",\"titleItems\":[{\"value\":\"Как получить деньги\"}],\"visible\":\"{{_elements.1560841.visible}}\"},{\"componentType\":\"accordion_1.0.1\",\"contentChildren\":[{\"componentType\":\"orderRichText_1.1.3\",\"isDesktop\":\"{{params.isDesktop}}\",\"layout_visible\":true,\"orderId\":\"{{params.referenceID}}\",\"padding\":{\"mobileLeftPadding\":0,\"mobileRightPadding\":0,\"webLeftPadding\":0,\"webRightPadding\":0},\"segments\":[{\"strikethrough\":false,\"underline\":false,\"value\":\"Если за время пути с ней что-то случится, мы возместим ущерб. \"},{\"actions\":[{\"actionType\":\"deeplink\",\"deeplink\":\"ru.avito://2/webview?url=https%3A%2F%2Fwww.avito.ru%2Fgeneral%2Fseller-protection%3Futm_source%3Davito%26utm_medium%3Dorder_page_confirmed%26utm_campaign%3Dseller_protection \"}],\"color\":{\"dark\":\"#009CF0\",\"light\":\"#0099F7\"},\"strikethrough\":false,\"underline\":false,\"value\":\"Узнать больше\"}],\"textStyle\":\"textS10\",\"visible\":true}],\"layout_visible\":true,\"style\":\"accordionH50\",\"titleItems\":[{\"value\":\"Посылка защищена\"}],\"visible\":true},{\"componentType\":\"accordion_1.0.1\",\"contentChildren\":[{\"componentType\":\"text_1.0.0\",\"layout_visible\":true,\"styleName\":\"textS10\",\"text\":\"Вы сможете проследить за его статусом на этой странице.\",\"visible\":true}],\"layout_visible\":true,\"style\":\"accordionH50\",\"titleItems\":[{\"value\":\"Заказ доставят за \"},{\"value\":\"{{_sources.68667.deliveryInfo.deliveryDateInDays}}\"}],\"visible\":true},{\"componentType\":\"accordion_1.0.1\",\"contentChildren\":[{\"componentType\":\"orderRichText_1.1.5\",\"isDesktop\":\"{{params.isDesktop}}\",\"layout_visible\":true,\"orderId\":\"{{params.referenceID}}\",\"padding\":{\"mobileLeftPadding\":0,\"mobileRightPadding\":0,\"webLeftPadding\":0,\"webRightPadding\":0},\"segments\":[{\"strikethrough\":false,\"underline\":false,\"value\":\"Вещи смогут померить в пункте выдачи. Даже если решите отключить примерку на объявлении, она всё равно останется доступной для этого покупателя до завершения сделки.\"}],\"textStyle\":\"textS10\",\"visible\":true}],\"layout_visible\":\"{{_sources.68667.deliveryInfo.isTryOnEnabled}}\",\"style\":\"accordionH50\",\"titleItems\":[{\"value\":\"Заказ с примеркой\"}],\"visible\":\"{{_sources.68667.deliveryInfo.isTryOnEnabled}}\"},{\"componentType\":\"accordion_1.0.1\",\"contentChildren\":[{\"componentType\":\"text_1.0.0\",\"layout_visible\":true,\"styleName\":\"textS10\",\"text\":\"Нажмите «Посмотреть пункты приёма», чтобы увидеть подходящие отделения.\",\"visible\":true}],\"layout_visible\":true,\"style\":\"accordionH50\",\"titleItems\":[{\"value\":\"Посылки принимают не везде\"}],\"visible\":true},{\"componentType\":\"orderRichText_1.1.3\",\"isDesktop\":\"{{params.isDesktop}}\",\"layout_visible\":true,\"orderId\":\"{{params.referenceID}}\",\"padding\":{\"mobileLeftPadding\":0,\"mobileRightPadding\":0,\"webLeftPadding\":0,\"webRightPadding\":0},\"segments\":[{\"strikethrough\":false,\"underline\":false,\"value\":\"Убедитесь, что товар не входит \"},{\"actions\":[{\"actionType\":\"deeplink\",\"deeplink\":\"ru.avito://2/webview?url=https%3A%2F%2Fsupport.avito.ru%2Fsections%2F62%3FarticleId%3D1898\\u0026mavAuth=true\"}],\"color\":{\"dark\":\"#009CF0\",\"light\":\"#0099F7\"},\"strikethrough\":false,\"underline\":false,\"value\":\"в список запрещённых\"},{\"strikethrough\":false,\"underline\":false,\"value\":\".\"},{\"strikethrough\":false,\"underline\":false,\"value\":\" Отправляя его, вы соглашаетесь \"},{\"actions\":[{\"actionType\":\"deeplink\",\"deeplink\":\"ru.avito://2/webview?url=http