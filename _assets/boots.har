datesForm\":false},{\"id\":171955,\"title\":\"Состояние от Авито\",\"displayTitle\":\"Новое с биркой\",\"type\":\"select\",\"immutable\":false,\"widget\":{\"type\":\"hidden\"},\"isRange\":false,\"value\":\"3280746\",\"values\":[{\"id\":\"3280746\",\"title\":\"Новое с биркой\"},{\"id\":\"3280747\",\"title\":\"Как новое\"},{\"id\":\"3280748\",\"title\":\"Отличное\"},{\"id\":\"3280749\",\"title\":\"Хорошее\"},{\"id\":\"3280750\",\"title\":\"Удовлетворительное\"}],\"hasSuggest\":false,\"updatesForm\":true},{\"id\":185077,\"title\":\"Публиковался в данной категории\",\"displayTitle\":\"Да\",\"type\":\"select\",\"immutable\":false,\"widget\":{\"type\":\"hidden\"},\"isRange\":false,\"value\":\"3341129\",\"values\":[{\"id\":\"3341128\",\"title\":\"Нет\"},{\"id\":\"3341129\",\"title\":\"Да\"}],\"hasSuggest\":false,\"updatesForm\":true},{\"id\":14890816,\"type\":\"slot\",\"label\":\"Преимущества\",\"widget\":{\"type\":\"iconList\",\"config\":{\"list\":[{\"icon\":\"StatisticsIcon\",\"text\":\"До 10% больше продаж\"},{\"icon\":\"CardsIcon\",\"text\":\"Видно сразу все варианты товара\"},{\"icon\":\"CategoryIcon\",\"text\":\"Каждое объявление показываем в поиске отдельно\"}],\"spaceTop\":\"8\",\"textMaxLines\":2,\"title\":\"Преимущества\"}},\"value\":{}},{\"id\":11430599,\"type\":\"slot\",\"label\":\"Несколько штук в наличии\",\"widget\":{\"type\":\"stockManagement\",\"config\":{\"inputField\":{\"constraints\":{\"max\":{\"message\":\"Укажите число до 1 000 000\",\"value\":999999},\"min\":{\"message\":\"Укажите число больше 1\",\"value\":1}},\"displaying\":{\"hideTitle\":true,\"postfix\":\"\"},\"hint\":\"Количество можно не указывать\",\"label\":\"Количество\",\"placeholder\":\"Количество\",\"type\":\"quantity\"},\"size\":\"m\",\"switcherField\":{\"label\":\"Несколько штук в наличии\",\"linkTitle\":\"Как это работает\",\"tooltip\":{\"content\":[{\"content\":\"Покупатели увидят, что вы продаёте несколько штук, упаковок или других единиц товара — и смогут купить больше одной.\",\"title\":\"В объявлении появится отметка о количестве\"},{\"content\":\"Если она будет доступна и вы её включите, то сразу несколько человек смогут оформить заказ.\\n\\n А если укажете точное количество товара, мы поможем не набрать лишних заказов: когда запасы закончатся, снимем объявление с публикации или уберём из него кнопки «Купить с доставкой» и «Добавить в корзину».\",\"title\":\"Как это работает с Авито Доставкой\"}],\"title\":\"В объявлении появится отметка о количестве\"}}}},\"value\":{\"stockMultiple\":false}},{\"id\":11430636,\"type\":\"slot\",\"label\":\"contactInfo\",\"widget\":{\"type\":\"contactInfo\",\"config\":{\"emailField\":{\"id\":\"email\",\"immutable\":false,\"required\":true,\"title\":\"Электронная почта\",\"type\":\"email\"},\"managerField\":{\"id\":\"manager\",\"immutable\":false,\"required\":false,\"title\":\"Контактное лицо\",\"type\":\"char\"},\"nameField\":{\"id\":\"name\",\"immutable\":false,\"required\":true,\"title\":\"Имя\",\"type\":\"char\"},\"phoneField\":{\"id\":\"phone\",\"immutable\":false,\"required\":true,\"title\":\"Телефон\",\"type\":\"char\"},\"size\":\"m\",\"slotFieldsToParams\":{\"email\":\"email\",\"manager\":\"manager\",\"name\":\"name\",\"phone\":\"phone\"}}},\"value\":{\"phone\":\"+7 985 189-80-29\"}},{\"id\":11430640,\"type\":\"slot\",\"label\":\"inAppCallsDevices\",\"widget\":{\"type\":\"inAppCallsDevices\",\"config\":{\"iacDevices\":[{\"id\":\"2CE28A1D-3647-4484-AFAA-71F3A4E4C0B5\",\"name\":\"iPhone 15\"}],\"iacForPro\":false,\"iacProUser\":false}},\"value\":{\"iacDevices\":[\"2CE28A1D-3647-4484-AFAA-71F3A4E4C0B5\"],\"iacProChosen\":false}},{\"id\":11430646,\"type\":\"slot\",\"label\":\"Вопрос 1\",\"widget\":{\"type\":\"information\",\"config\":{\"linkProps\":{\"display\":\"block\"},\"size\":\"m\",\"text\":{\"attributes\":{\"fullText\":{\"newTab\":true,\"type\":\"link\",\"value\":{\"title\":\"Полный текст согласия\",\"url\":\"https://support.avito.ru/articles/2333\"}}},\"text\":\"1. Согласны ли вы с тем, что ваши персональные данные будут отображаться в объявлениях и публичном профиле на Авито? Если да, ответьте на второй вопрос и нажмите «Продолжить». {{fullText}}\"},\"textProps\":{\"color\":\"black\",\"size\":\"m\"}}},\"value\":{}},{\"id\":11430638,\"type\":\"slot\",\"label\":\"contactMethod\",\"widget\":{\"type\":\"contactMethod\",\"config\":{\"field\":{\"id\":\"contactMethod\",\"immutable\":false,\"required\":true,\"title\":\"Способ связи\",\"type\":\"select\",\"values\":[{\"id\":\"any\",\"title\":\"Звонки и сообщения\"},{\"id\":\"phone\",\"title\":\"Только звонки\"},{\"id\":\"messenger\",\"title\":\"Только сообщения\"}]},\"size\":\"m\"}},\"value\":{\"contactMethod\":\"any\"}},{\"id\":11430649,\"type\":\"slot\",\"label\":\"Вопрос 2\",\"widget\":{\"type\":\"information\",\"config\":{\"size\":\"m\",\"text\":{\"text\":\"2. Разрешаете ли вы неограниченному кругу лиц обрабатывать персональные данные, которые размещаете в открытом доступе? Чтобы ответить, отметьте один из пунктов ниже. Это не повлияет на работу с Авито: люди всё равно смогут найти ваши объявления, и связаться с вами.\"},\"textProps\":{\"color\":\"black\",\"size\":\"m\"}}},\"value\":{}},{\"id\":11430651,\"type\":\"slot\",\"label\":\"Обработка данных определение\",\"widget\":{\"type\":\"information\",\"config\":{\"linkProps\":{\"color\":\"gray48\",\"underline\":true},\"size\":\"m\",\"text\":{\"attributes\":{\"more\":{\"newTab\":true,\"type\":\"link\",\"value\":{\"title\":\"Подробнее\",\"url\":\"https://support.avito.ru/articles/2334\"}}},\"text\":\"Обрабатывать данные — значит собирать их в базы, публиковать на сторонних сайтах или выполнять другие действия. {{more}}\"},\"textProps\":{\"color\":\"gray48\",\"size\":\"s\"}}},\"value\":{}},{\"id\":11430660,\"type\":\"slot\",\"label\":\"information\",\"widget\":{\"type\":\"information\",\"config\":{\"size\":\"m\",\"text\":{\"attributes\":{\"userAgreement\":{\"newTab\":true,\"type\":\"link\",\"value\":{\"title\":\"с правилами Авито\",\"url\":\"https://support.avito.ru/sections/200645056\"}}},\"text\":\"Вы публикуете объявление и данные в нём, чтобы их мог посмотреть кто угодно в интернете. Вы также соглашаетесь {{userAgreement}}.\"}}},\"value\":{}},{\"id\":13988011,\"type\":\"slot\",\"label\":\"Примерка\",\"widget\":{\"type\":\"sectionSeparator\",\"config\":{\"showTopSeparator\":false,\"subtitle\":\"\",\"textProps\":{\"size\":\"xxxl\"},\"title\":\"Примерка\"}},\"value\":{}},{\"id\":13988013,\"type\":\"slot\",\"label\":\"Как это работает\",\"widget\":{\"type\":\"iconList\",\"config\":{\"list\":[{\"icon\":\"TshirtIcon\",\"text\":\"Доступна покупателям только в пунктах выдачи с примерочной\"},{\"icon\":\"VerifyIcon\",\"text\":\"Проследим, чтобы товар не испортили, а если что — подскажем, как подать заявление на компенсацию\"},{\"icon\":\"PersonsIcon\",\"text\":\"С примеркой проще привлечь покупателей\"}],\"spaceTop\":\"8\",\"textMaxLines\":3,\"title\":\"Как это работает\"}},\"value\":{}},{\"id\":11430647,\"type\":\"slot\",\"label\":\"Если вы решите не принимать условия\",\"widget\":{\"type\":\"information\",\"config\":{\"size\":\"m\",\"text\":{\"text\":\"Если вы решите не принимать условия, сможете использовать Авито только для просмотра чужих объявлений — создать профиль и разместить свои предложения не получится.\"},\"textProps\":{\"color\":\"gray48\",\"size\":\"s\"}}},\"value\":{}},{\"id\":11430614,\"type\":\"slot\",\"label\":\"Субсидирование доставки V2\",\"widget\":{\"type\":\"deliverySubsidies\",\"config\":{}},\"value\":{\"subsidyId\":\"none\"}},{\"id\":11430635,\"type\":\"slot\",\"label\":\"profileInfo\",\"widget\":{\"type\":\"profileInfo\",\"config\":{\"field\":{\"id\":\"profileInfo\"},\"size\":\"m\"}},\"value\":{}},{\"id\":11430642,\"type\":\"slot\",\"label\":\"Немедленная публикация\",\"widget\":{\"type\":\"publishAfterCreation\",\"config\":{}},\"value\":{}},{\"id\":11430644,\"type\":\"slot\",\"label\":\"Информация о персональных данных\",\"widget\":{\"type\":\"information\",\"config\":{\"size\":\"m\",\"text\":{\"text\":\"Пользователи Авито добавляют в публичный профиль и объявления личную информацию. По закону мы должны спросить вас о двух вещах.\"},\"textProps\":{\"color\":\"black\",\"size\":\"m\"}}},\"value\":{}},{\"id\":11430611,\"type\":\"slot\",\"label\":\"Доставка силами продавца\",\"widget\":{\"type\":\"deliveryDbsToggles\",\"config\":{\"dbsCourierField\":{\"id\":\"deliveryDbsCourier\",\"title\":\"Курьером\",\"type\":\"boolean\"},\"dbsField\":{\"id\":\"deliveryDbs\",\"subtitle\":{\"attributes\":{\"title\":{\"type\":\"attributes\",\"value\":{\"list\":[{\"type\":\"fontStyle\",\"value\":\"regular\"},{\"type\":\"fontColor\",\"value\":\"#858585\",\"valueName\":\"gray48\"}],\"title\":\"СДЭК, Почта России и другие\"}}},\"text\":\"{{title}}\"},\"title\":\"В пункт выдачи\",\"type\":\"boolean\"},\"readyToDisplay\":true,\"size\":\"m\",\"subtitle\":{\"attributes\":{\"link\":{\"type\":\"link\",\"value\":{\"list\":[{\"type\":\"fontColor\",\"value\":\"#757575\"},{\"type\":\"underline\"}],\"title\":\"Подробнее\",\"url\":\"https://support.avito.ru/articles/4234#2491\"}}},\"text\":\"Организуйте отправку сами — в пункты выдачи или курьерами. А оплату получайте через Авито.\\n{{link}}\",\"version\":1},\"title\":{\"attributes\":{\"title\":{\"type\":\"attributes\",\"value\":{\"list\":[{\"theme\":\"avitoRe23\",\"type\":\"textStyle\",\"value\":\"h5\"}],\"title\":\"Доставка силами продавца\"}}},\"text\":\"{{title}}\",\"version\":1}}},\"value\":{}},{\"id\":11430619,\"type\":\"slot\",\"label\":\"Плашка о наличии комиссии за доставку\",\"widget\":{\"type\":\"cptFeeNotice\",\"config\":{\"content\":{\"components\":[{\"content\":{\"children\":[{\"content\":{\"children\":[{\"content\":{\"attributes\":{\"font\":{\"style\":\"m1\"}},\"tokens\":[{\"title\":\"Есть комиссия за продажу с доставкой\",\"type\":\"text\"}]},\"type\":\"label\"}],\"padding\":{\"bottom\":20,\"left\":24,\"top\":16}},\"type\":\"verticalContainer\"}],\"margin\":{\"top\":20},\"padding\":{\"all\":0},\"roundEdges\":\"all\",\"style\":\"warmgray\",\"theme\":\"avitoRe23\"},\"type\":\"promoBlock\"}],\"id\":\"cpt-notice\"}}},\"value\":{}},{\"id\":14890812,\"type\":\"slot\",\"label\":\"Мультиобъявление\",\"widget\":{\"type\":\"sectionSeparator\",\"config\":{\"showTopSeparator\":false,\"subtitle\":\"\",\"textProps\":{\"size\":\"xxxl\"},\"title\":\"Мультиобъявление\"}},\"value\":{}},{\"id\":14499715,\"type\":\"slot\",\"label\":\"Рекомендованная цена\",\"widget\":{\"type\":\"universalBeduin\",\"config\":{\"contentUrl\":\"api/1/imv/goods/publish/slot\"}},\"value\":{}},{\"id\":12857885,\"type\":\"slot\",\"label\":\"Самовывоз\",\"widget\":{\"type\":\"deliveryCncToggles\",\"config\":{\"checkbox\":{\"description\":\"Если в них не указаны сроки подготовки, применим стандартные — от 1 до 5 дней\",\"title\":\"Включить самовывоз на всех объявлениях\"},\"cncToggle\":{\"id\":\"deliveryCnc\",\"title\":\"Самовывоз\",\"type\":\"boolean\"},\"daysRange\":{\"errorEmptyField\":{\"attributes\":{\"title\":{\"type\":\"attributes\",\"value\":{\"list\":[{\"type\":\"textStyle\",\"value\":\"s10\"},{\"type\":\"fontColor\",\"value\":\"#ff4053\"}],\"title\":\"Обязательное поле\"}}},\"text\":\"{{title}}\"},\"errorFromValueField\":{\"attributes\":{\"title\":{\"type\":\"attributes\",\"value\":{\"list\":[{\"type\":\"textStyle\",\"value\":\"s10\"},{\"type\":\"fontColor\",\"value\":\"#ff4053\"}],\"title\":\"Укажите срок не меньше, чем в \\\"от\\\"\"}}},\"text\":\"{{title}}\"},\"initialPreparePeriod\":{\"maxPreparationDays\":5,\"minPreparationDays\":1},\"periodInfo\":{\"attributes\":{\"title\":{\"type\":\"attributes\",\"value\":{\"list\":[{\"type\":\"textStyle\",\"value\":\"s10\"},{\"type\":\"fontColor\",\"value\":\"#757575\"}],\"title\":\"Максимальный срок — 14 дней\"}}},\"text\":\"{{title}}\"},\"placeholderFrom\":\"от\",\"placeholderTo\":\"до\",\"subtitle\":{\"attributes\":{\"title\":{\"type\":\"attributes\",\"value\":{\"title\":\"Сколько дней нужно, чтобы подготовить заказ. Покажем эту информацию в объявлении.\"}}},\"text\":\"{{title}}\"},\"title\":{\"attributes\":{\"title\":{\"type\":\"attributes\",\"value\":{\"list\":[{\"type\":\"textStyle\",\"value\":\"h5\"}],\"title\":\"Срок подготовки заказа\"}}},\"text\":\"{{title}}\"}},\"size\":\"m\",\"subtitle\":{\"attributes\":{\"link\":{\"type\":\"link\",\"value\":{\"list\":[{\"type\":\"fontColor\",\"value\":\"#757575\"},{\"type\":\"underline\"}],\"title\":\"Подробнее\",\"url\":\"https://support.avito.ru/articles/3276\"}}},\"text\":\"Покупатель платит за заказ через Авито и приезжает за ним по вашему адресу.\\n{{link}}\"},\"title\":{\"attributes\":{\"title\":{\"type\":\"attributes\",\"value\":{\"list\":[{\"type\":\"textStyle\",\"value\":\"h5\"}],\"title\":\"Самовывоз с онлайн-оплатой\"}}},\"text\":\"{{title}}\"}}},\"value\":{\"cncProperties\":{\"address\":\"Московская обл., Серпухов, Московское ш., 41\",\"enableForAllItems\":false,\"maxPreparationDays\":\"5\",\"minPreparationDays\":\"1\"},\"deliveryCnc\":true}},{\"id\":15574374,\"type\":\"slot\",\"label\":\"Лигал Авито Доставка\",\"widget\":{\"type\":\"information\",\"config\":{\"text\":{\"attributes\":{\"loyaltyuserAgreement\":{\"type\":\"link\",\"value\":{\"title\":\"с правилами акции\",\"url\":\"https://www.avito.ru/legal/promo/discount-for-sellers-avito-delivery\"}},\"userAgreement\":{\"type\":\"link\",\"value\":{\"title\":\"с условиями\",\"url\":\"https://www.avito.ru/legal/goods/delivery\"}}},\"text\":\"Включая Авито Доставку с выбранными параметрами и нажимая «Продолжить», вы соглашаетесь {{userAgreement}} и {{loyaltyuserAgreement}}.\"}}},\"value\":{}},{\"id\":13988010,\"type\":\"slot\",\"label\":\"Картинка подсказка для примерок\",\"widget\":{\"type\":\"image\",\"config\":{\"contentInsets\":{\"bottom\":0,\"left\":10,\"right\":10,\"top\":0},\"images\":{\"1065x720\":\"https://avito.st/static/ims/0a287828-51c8-4b5b-bc1c-9d9833bf8c52_try_on_image_common_1065x720.png\",\"1420x960\":\"https://avito.st/static/ims/0a287828-51c8-4b5b-bc1c-9d9833bf8c52_try_on_image_common_1420x960.png\",\"355x240\":\"https://avito.