\\\\:\\\\/\\\\/|www\\\\.|file\\\\:\\\\/\\\\/)+[\\\\w\\\\.\\\\-]+\\\\.[a-z]{2,4}(\\\\/[\\\\w\\\\/\\\\.\\\\-\\\\.\\\\?\\\\,\\\\'\\\\/\\\\\\\\+\\u0026amp;%\\\\$#\\\\=~]*|($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+))\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"description:link\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"Не указывайте эл. почту в описании. Объявление может быть отклонено. Для связи с продавцом используется телефон или сервис сообщений.\",\"passOnMatch\":false,\"regexp\":\"[a-z]+[\\\\.\\\\-a-z0-9_]*[ ]*@[ ]*[\\\\.\\\\-a-z0-9_]*[ ]*\\\\.[ ]*(?:ru|com|org|ua|uk|net|cn|nl|eu|info|biz|kz|bu|su|de|fr|lt|cz)($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"description:email\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"Перенесите номер телефона из описания в поле «Телефон» на следующем экране. Вы можете продолжить публикацию, если считаете, что предупреждение ошибочно.\",\"passOnMatch\":false,\"regexp\":\"(^|[^\\\\d-])((8|\\\\+?7)[ .-]?)?\\\\(?9\\\\d{2}\\\\)?[ .-]?([ .-]?\\\\d[ .-]?){7}\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"description:phone\"}}],\"displaying\":{\"hideTitle\":true,\"multiline\":true},\"size\":\"m\"}},\"placeholder\":\"Введите описание\",\"isRange\":false,\"displaying\":{\"hideTitle\":true,\"multiline\":true},\"constraints\":[{\"type\":\"length\",\"value\":{\"max\":7500,\"maxV2\":7500,\"message\":\"Длина описания не может быть менее 1 символа или превышать 7500 символов\",\"min\":1,\"minV2\":1,\"tag\":\"description:limit_min_max\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим правилам нельзя размещать объявления о покупке. Ищите интересующие вас товары в поиске.\",\"passOnMatch\":false,\"regexp\":\"(^|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)куплю($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"description:purchase\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"Не указывайте ссылки на сторонние ресурсы в описании. Объявление может быть отклонено. Опишите свойства объявления текстом.\",\"passOnMatch\":false,\"regexp\":\"(((ht|f)tp(s?))\\\\:\\\\/\\\\/|www\\\\.|file\\\\:\\\\/\\\\/)+[\\\\w\\\\.\\\\-]+\\\\.[a-z]{2,4}(\\\\/[\\\\w\\\\/\\\\.\\\\-\\\\.\\\\?\\\\,\\\\'\\\\/\\\\\\\\+\\u0026amp;%\\\\$#\\\\=~]*|($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+))\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"description:link\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"Не указывайте эл. почту в описании. Объявление может быть отклонено. Для связи с продавцом используется телефон или сервис сообщений.\",\"passOnMatch\":false,\"regexp\":\"[a-z]+[\\\\.\\\\-a-z0-9_]*[ ]*@[ ]*[\\\\.\\\\-a-z0-9_]*[ ]*\\\\.[ ]*(?:ru|com|org|ua|uk|net|cn|nl|eu|info|biz|kz|bu|su|de|fr|lt|cz)($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"description:email\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"Перенесите номер телефона из описания в поле «Телефон» на следующем экране. Вы можете продолжить публикацию, если считаете, что предупреждение ошибочно.\",\"passOnMatch\":false,\"regexp\":\"(^|[^\\\\d-])((8|\\\\+?7)[ .-]?)?\\\\(?9\\\\d{2}\\\\)?[ .-]?([ .-]?\\\\d[ .-]?){7}\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"description:phone\"}},{\"type\":\"required\",\"value\":{\"tag\":\"100002:text:required\",\"message\":\"Пожалуйста, заполните описание\",\"passOnMatch\":false,\"severity\":\"error\"}}],\"updatesForm\":false},{\"id\":187331,\"title\":\"Требуется верификация Бизнес 360\",\"displayTitle\":\"Да\",\"type\":\"select\",\"immutable\":false,\"widget\":{\"type\":\"hidden\",\"config\":{\"constraints\":[{\"type\":\"\",\"value\":{\"message\":\"\",\"passOnMatch\":false,\"regexp\":\"\",\"severity\":\"\",\"tag\":\"\"}}],\"displaying\":{\"postfix\":null},\"size\":null,\"value\":null}},\"isRange\":false,\"displaying\":{\"postfix\":null},\"constraints\":[{\"type\":\"\",\"value\":{\"message\":\"\",\"passOnMatch\":false,\"regexp\":\"\",\"severity\":\"\",\"tag\":\"\"}}],\"value\":\"1\",\"values\":[{\"id\":\"1\",\"title\":\"Да\"},{\"id\":\"0\",\"title\":\"Нет\"}],\"hasSuggest\":false,\"updatesForm\":false},{\"id\":100001,\"title\":\"Название объявления\",\"type\":\"char\",\"required\":true,\"immutable\":false,\"widget\":{\"type\":\"input\",\"config\":{\"constraints\":[{\"type\":\"regexp\",\"value\":{\"message\":\"Не пишите в названии цену, для этого есть отдельное поле.\",\"passOnMatch\":false,\"regexp\":\"(^|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)[0-9]{3,}\\\\s*[\\\\$\\\\€\\\\¥]|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+(руб|рублей|₽)($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:price_app\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим правилам нельзя размещать объявления о покупке. Ищите интересующие вас товары в поиске.\",\"passOnMatch\":false,\"regexp\":\"(^|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)куплю($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:purchase\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим правилам нельзя писать в названии: скидка, акция, дёшево, срочно и т. д. Привлекайте внимание к объявлению подробным описанием и чёткими фотографиями.\",\"passOnMatch\":false,\"regexp\":\"(^|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)(срочно|внимание|даром|торопитесь|выгодно)($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:attention\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим правилам нельзя указывать телефоны, ссылки и эл. почту в названии.\",\"passOnMatch\":false,\"regexp\":\"(^|[^\\\\d-])((8|\\\\+?7)[ .-]?)?\\\\(?9\\\\d{2}\\\\)?[ .-]?([ .-]?\\\\d[ .-]?){7}\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:phone\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим правилам нельзя указывать телефоны, ссылки и эл. почту в названии.\",\"passOnMatch\":false,\"regexp\":\"(((ht|f)tp(s?))\\\\:\\\\/\\\\/|www\\\\.|file\\\\:\\\\/\\\\/)+[\\\\w\\\\.\\\\-]+\\\\.[a-z]{2,4}(\\\\/[\\\\w\\\\/\\\\.\\\\-\\\\.\\\\?\\\\,\\\\'\\\\/\\\\\\\\+\\u0026amp;%\\\\$#\\\\=~]*|($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+))\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:link\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим правилам нельзя указывать телефоны, ссылки и эл. почту в названии.\",\"passOnMatch\":false,\"regexp\":\"[a-z]+[\\\\.\\\\-a-z0-9_]*[ ]*@[ ]*[\\\\.\\\\-a-z0-9_]*[ ]*\\\\.[ ]*(?:ru|com|org|ua|uk|net|cn|nl|eu|info|biz|kz|bu|su|de|fr|lt|cz)($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:email\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"Не пишите в названии слово «продам». Вместо этого укажите точное название, чтобы покупателям было проще найти ваше предложение.\",\"passOnMatch\":false,\"regexp\":\"^(прода(ю|м|жа|(е|ё)т(ь)?ся))$\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:sale\"}},{\"type\":\"length\",\"value\":{\"max\":50,\"maxV2\":50,\"message\":\"Длина названия не может превышать 50 символов\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"Не упоминайте Instagram или Facebook. Они принадлежат Meta Platforms Inc., чья деятельность запрещена в России.\",\"passOnMatch\":false,\"regexp\":\"(^|[^a-zA-Z0-9а-яА-Я])(?:[mм][eе][tт][аa@еуы]|f[aа@]ceb[o0][o0][kк]|ф[еэ]йсбук|[iи][nн][sс][tт][aа@][gг][rр][aа@][mм]|[iи][nн][sс][тt])($|[^a-zA-Z0-9а-яА-Я])\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:meta\"}}],\"size\":\"m\"}},\"placeholder\":\"Введите значение\",\"isRange\":false,\"constraints\":[{\"type\":\"regexp\",\"value\":{\"message\":\"Не пишите в названии цену, для этого есть отдельное поле.\",\"passOnMatch\":false,\"regexp\":\"(^|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)[0-9]{3,}\\\\s*[\\\\$\\\\€\\\\¥]|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+(руб|рублей|₽)($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:price_app\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим правилам нельзя размещать объявления о 