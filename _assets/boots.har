            "text": "{\"result\":{\"navigation\":{\"attributes\":[{\"id\":175,\"value\":2804317},{\"id\":118631,\"value\":2262814}],\"categoryId\":27,\"categoryIds\":[27],\"config\":{\"branch\":\"latest\",\"layout\":\"mav_add\",\"tree\":\"professional_mobile\"}},\"params\":[{\"id\":178152,\"title\":\"Оригинальные фотографии\",\"type\":\"int\",\"immutable\":false,\"widget\":{\"type\":\"autoImageEnhancementOriginals\"},\"isRange\":false,\"multiple\":true,\"value\":[54057619655],\"updatesForm\":false},{\"id\":2826,\"title\":\"Вид объявления\",\"displayTitle\":\"Товар приобретён на продажу\",\"type\":\"select\",\"required\":true,\"immutable\":false,\"widget\":{\"type\":\"select\",\"config\":{\"size\":\"m\"}},\"placeholder\":\"Выбрать\",\"isRange\":false,\"constraints\":[{\"type\":\"required\",\"value\":{\"tag\":\"2826:enumerable:required\",\"message\":\"Выберите значение из списка\",\"passOnMatch\":false,\"severity\":\"error\"}}],\"value\":\"20030\",\"values\":[{\"id\":\"20029\",\"title\":\"Продаю своё\"},{\"id\":\"20030\",\"title\":\"Товар приобретён на продажу\"},{\"id\":\"20031\",\"title\":\"Товар от производителя\"}],\"hasSuggest\":false,\"updatesForm\":true},{\"id\":183547,\"title\":\"Проверка заполнения поля\",\"type\":\"select\",\"immutable\":false,\"widget\":{\"type\":\"hidden\"},\"isRange\":false,\"values\":[{\"id\":\"1\",\"title\":\"Да\"},{\"id\":\"0\",\"title\":\"Нет\"}],\"hasSuggest\":false,\"updatesForm\":true},{\"id\":100001,\"title\":\"Название объявления\",\"type\":\"char\",\"required\":true,\"immutable\":false,\"widget\":{\"type\":\"input\",\"config\":{\"constraints\":[{\"type\":\"regexp\",\"value\":{\"message\":\"Не пишите в названии цену, для этого есть отдельное поле.\",\"passOnMatch\":false,\"regexp\":\"(^|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)[0-9]{3,}\\\\s*[\\\\$\\\\€\\\\¥]|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+(руб|рублей|₽)($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:price_app\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим правилам нельзя размещать объявления о покупке. Ищите интересующие вас товары в поиске.\",\"passOnMatch\":false,\"regexp\":\"(^|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)куплю($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:purchase\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим правилам нельзя писать в названии: скидка, акция, дёшево, срочно и т. д. Привлекайте внимание к объявлению подробным описанием и чёткими фотографиями.\",\"passOnMatch\":false,\"regexp\":\"(^|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)(срочно|внимание|даром|торопитесь|выгодно)($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:attention\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим правилам нельзя указывать телефоны, ссылки и эл. почту в названии.\",\"passOnMatch\":false,\"regexp\":\"(^|[^\\\\d-])((8|\\\\+?7)[ .-]?)?\\\\(?9\\\\d{2}\\\\)?[ .-]?([ .-]?\\\\d[ .-]?){7}\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:phone\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим правилам нельзя указывать телефоны, ссылки и эл. почту в названии.\",\"passOnMatch\":false,\"regexp\":\"(((ht|f)tp(s?))\\\\:\\\\/\\\\/|www\\\\.|file\\\\:\\\\/\\\\/)+[\\\\w\\\\.\\\\-]+\\\\.[a-z]{2,4}(\\\\/[\\\\w\\\\/\\\\.\\\\-\\\\.\\\\?\\\\,\\\\'\\\\/\\\\\\\\+\\u0026amp;%\\\\$#\\\\=~]*|($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+))\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:link\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим правилам нельзя указывать телефоны, ссылки и эл. почту в названии.\",\"passOnMatch\":false,\"regexp\":\"[a-z]+[\\\\.\\\\-a-z0-9_]*[ ]*@[ ]*[\\\\.\\\\-a-z0-9_]*[ ]*\\\\.[ ]*(?:ru|com|org|ua|uk|net|cn|nl|eu|info|biz|kz|bu|su|de|fr|lt|cz)($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:email\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"Не пишите в названии слово «продам». Вместо этого укажите точное название, чтобы покупателям было проще найти ваше предложение.\",\"passOnMatch\":false,\"regexp\":\"^(прода(ю|м|жа|(е|ё)т(ь)?ся))$\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:sale\"}},{\"type\":\"length\",\"value\":{\"max\":50,\"maxV2\":50,\"message\":\"Длина названия не может превышать 50 символов\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"Не упоминайте Instagram или Facebook. Они принадлежат Meta Platforms Inc., чья деятельность запрещена в России.\",\"passOnMatch\":false,\"regexp\":\"(^|[^a-zA-Z0-9а-яА-Я])(?:[mм][eе][tт][аa@еуы]|f[aа@]ceb[o0][o0][kк]|ф[еэ]йсбук|[iи][nн][sс][tт][aа@][gг][rр][aа@][mм]|[iи][nн][sс][тt])($|[^a-zA-Z0-9а-яА-Я])\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:meta\"}}],\"size\":\"m\"}},\"placeholder\":\"Введите значение\",\"isRange\":false,\"constraints\":[{\"type\":\"regexp\",\"value\":{\"message\":\"Не пишите в названии цену, для этого есть отдельное поле.\",\"passOnMatch\":false,\"regexp\":\"(^|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)[0-9]{3,}\\\\s*[\\\\$\\\\€\\\\¥]|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+(руб|рублей|₽)($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:price_app\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим правилам нельзя размещать объявления о покупке. Ищите интересующие вас товары в поиске.\",\"passOnMatch\":false,\"regexp\":\"(^|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)куплю($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:purchase\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим правилам нельзя писать в названии: скидка, акция, дёшево, срочно и т. д. Привлекайте внимание к объявлению подробным описанием и чёткими фотографиями.\",\"passOnMatch\":false,\"regexp\":\"(^|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)(срочно|внимание|даром|торопитесь|выгодно)($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:atte