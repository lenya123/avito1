46,5\"},{\"id\":\"1211573\",\"title\":\"47\"},{\"id\":\"1211574\",\"title\":\"47,5\"},{\"id\":\"1211575\",\"title\":\"48+\"}],\"hasSuggest\":false,\"updatesForm\":false},{\"id\":165436,\"title\":\"Тип предмета одежды\",\"type\":\"multiselect\",\"immutable\":false,\"widget\":{\"type\":\"hidden\"},\"isRange\":false,\"multiple\":true,\"values\":[{\"id\":\"3265830\",\"title\":\"Верх\"},{\"id\":\"3265831\",\"title\":\"Низ\"}],\"hasSuggest\":false,\"updatesForm\":false},{\"id\":196273,\"title\":\"Оптовые продажи предикт\",\"type\":\"select\",\"immutable\":false,\"widget\":{\"type\":\"hidden\"},\"isRange\":false,\"values\":[{\"id\":\"1\",\"title\":\"Да\"},{\"id\":\"0\",\"title\":\"Нет\"}],\"hasSuggest\":false,\"updatesForm\":false},{\"id\":11430644,\"type\":\"slot\",\"label\":\"Информация о персональных данных\",\"widget\":{\"type\":\"information\",\"config\":{\"size\":\"m\",\"text\":{\"text\":\"Пользователи Авито добавляют в публичный профиль и объявления личную информацию. По закону мы должны спросить вас о двух вещах.\"},\"textProps\":{\"color\":\"black\",\"size\":\"m\"}}},\"value\":{}},{\"id\":11430651,\"type\":\"slot\",\"label\":\"Обработка данных определение\",\"widget\":{\"type\":\"information\",\"config\":{\"linkProps\":{\"color\":\"gray48\",\"underline\":true},\"size\":\"m\",\"text\":{\"attributes\":{\"more\":{\"newTab\":true,\"type\":\"link\",\"value\":{\"title\":\"Подробнее\",\"url\":\"https://support.avito.ru/articles/2334\"}}},\"text\":\"Обрабатывать данные — значит собирать их в базы, публиковать на сторонних сайтах или выполнять другие действия. {{more}}\"},\"textProps\":{\"color\":\"gray48\",\"size\":\"s\"}}},\"value\":{}},{\"id\":11430645,\"type\":\"slot\",\"label\":\"Личная информация определение\",\"widget\":{\"type\":\"information\",\"config\":{\"size\":\"m\",\"text\":{\"text\":\"Личная информация, или персональные данные — это ваши имя, детали из резюме и другие сведения, которые вы самостоятельно публикуете на Авито.\"},\"textProps\":{\"color\":\"gray48\",\"size\":\"s\"}}},\"value\":{}},{\"id\":11430649,\"type\":\"slot\",\"label\":\"Вопрос 2\",\"widget\":{\"type\":\"information\",\"config\":{\"size\":\"m\",\"text\":{\"text\":\"2. Разрешаете ли вы неограниченному кругу лиц обрабатывать персональные данные, которые размещаете в открытом доступе? Чтобы ответить, отметьте один из пунктов ниже. Это не повлияет на работу с Авито: люди всё равно смогут найти ваши объявления, и связаться с вами.\"},\"textProps\":{\"color\":\"black\",\"size\":\"m\"}}},\"value\":{}},{\"id\":11430559,\"type\":\"slot\",\"label\":\"Саджест названия и Опечаточник\",\"widget\":{\"type\":\"textSuggestions\",\"config\":{\"settings\":{\"minQueryLength\":3,\"suggestAPIUri\":\"/api/1/publish/title/suggest\",\"targetFieldId\":100001},\"size\":\"m\"}},\"value\":{}},{\"id\":11430642,\"type\":\"slot\",\"label\":\"Немедленная публикация\",\"widget\":{\"type\":\"publishAfterCreation\",\"config\":{}},\"value\":{}},{\"id\":11430636,\"type\":\"slot\",\"label\":\"contactInfo\",\"widget\":{\"type\":\"contactInfo\",\"config\":{\"emailField\":{\"id\":\"email\",\"immutable\":false,\"required\":true,\"title\":\"Электронная почта\",\"type\":\"email\"},\"managerField\":{\"id\":\"manager\",\"immutable\":false,\"required\":false,\"title\":\"Контактное лицо\",\"type\":\"char\"},\"nameField\":{\"id\":\"name\",\"immutable\":false,\"required\":true,\"title\":\"Имя\",\"type\":\"char\"},\"phoneField\":{\"id\":\"phone\",\"immutable\":false,\"required\":true,\"title\":\"Телефон\",\"type\":\"char\"},\"size\":\"m\",\"slotFieldsToParams\":{\"email\":\"email\",\"manager\":\"manager\",\"name\":\"name\",\"phone\":\"phone\"}}},\"value\":{\"phone\":\"+7 985 189-80-29\"}},{\"id\":11430635,\"type\":\"slot\",\"label\":\"profileInfo\",\"widget\":{\"type\":\"profileInfo\",\"config\":{\"field\":{\"id\":\"profileInfo\"},\"size\":\"m\"}},\"value\":{}},{\"id\":11430640,\"type\":\"slot\",\"label\":\"inAppCallsDevices\",\"widget\":{\"type\":\"inAppCallsDevices\",\"config\":{\"iacDevices\":[{\"id\":\"2CE28A1D-3647-4484-AFAA-71F3A4E4C0B5\",\"name\":\"iPhone 15\"}],\"iacForPro\":false,\"iacProUser\":false}},\"value\":{\"iacDevices\":[\"2CE28A1D-3647-4484-AFAA-71F3A4E4C0B5\"],\"iacProChosen\":false}},{\"id\":11430646,\"type\":\"slot\",\"label\":\"Вопрос 1\",\"widget\":{\"type\":\"information\",\"config\":{\"linkProps\":{\"display\":\"block\"},\"size\":\"m\",\"text\":{\"attributes\":{\"fullText\":{\"newTab\":true,\"type\":\"link\",\"value\":{\"title\":\"Полный текст согласия\",\"url\":\"https://support.avito.ru/articles/2333\"}}},\"text\":\"1. Согласны ли вы с тем, что ваши персональные данные будут отображаться в объявлениях и публичном профиле на Авито? Если да, ответьте на второй вопрос и нажмите «Продолжить». {{fullText}}\"},\"textProps\":{\"color\":\"black\",\"size\":\"m\"}}},\"value\":{}},{\"id\":11430647,\"type\":\"slot\",\"label\":\"Если вы решите не принимать условия\",\"widget\":{\"type\":\"information\",\"config\":{\"size\":\"m\",\"text\":{\"text\":\"Если вы решите не принимать условия, сможете использовать Авито только для просмотра чужих объявлений — создать профиль и разместить свои предложения не получится.\"},\"textProps\":{\"color\":\"gray48\",\"size\":\"s\"}}},\"value\":{}},{\"id\":14499715,\"type\":\"slot\",\"label\":\"Рекомендованная цена\",\"widget\":{\"type\":\"universalBeduin\",\"config\":{\"contentUrl\":\"api/1/imv/goods/publish/slot\"}},\"value\":{}},{\"id\":11430599,\"type\":\"slot\",\"label\":\"Несколько штук в наличии\",\"widget\":{\"type\":\"stockManagement\",\"config\":{\"inputField\":{\"constraints\":{\"max\":{\"message\":\"Укажите число до 1 000 000\",\"value\":999999},\"min\":{\"message\":\"Укажите число больше 1\",\"value\":1}},\"displaying\":{\"hideTitle\":true,\"postfix\":\"\"},\"hint\":\"Количество можно не указывать\",\"label\":\"Количество\",\"placeholder\":\"Количество\",\"type\":\"quantity\"},\"size\":\"m\",\"switcherField\":{\"label\":\"Несколько штук в наличии\",\"linkTitle\":\"Как это работает\",\"tooltip\":{\"content\":[{\"content\":\"Покупатели увидят, что вы продаёте несколько штук, упаковок или других единиц товара — и смогут купить больше одной.\",\"title\":\"В объявлении появится отметка о количестве\"},{\"content\":\"Если она будет доступна и вы её включите, то сразу несколько человек смогут оформить заказ.\\n\\n А если укажете точное количество товара, мы поможем не набрать лишних заказов: когда запасы закончатся, снимем объявление с публикации или уберём из него кнопки «Купить с доставкой» и «Добавить в корзину».\",\"title\":\"Как это работает с Авито Доставкой\"}],\"title\":\"В объявлении появится отметка о количестве\"}}}},\"value\":{\"stockMultiple\":false,\"stockQuantity\":1}},{\"id\":11430638,\"type\":\"slot\",\"label\":\"contactMethod\",\"widget\":{\"type\":\"contactMethod\",\"config\":{\"field\":{\"id\":\"contactMethod\",\"immutable\":false,\"required\":true,\"title\":\"Способ связи\",\"type\":\"select\",\"values\":[{\"id\":\"any\",\"title\":\"Звонки и сообщения\"},{\"id\":\"phone\",\"title\":\"Только звонки\"},{\"id\":\"messenger\",\"title\":\"Только сообщения\"}]},\"size\":\"m\"}},\"value\":{\"contactMethod\":\"any\"}},{\"id\":11430660,\"type\":\"slot\",\"label\":\"information\",\"widget\":{\"type\":\"information\",\"config\":{\"size\":\"m\",\"text\":{\"attributes\":{\"userAgreement\":{\"newTab\":true,\"type\":\"link\",\"value\":{\"title\":\"с правилами Авито\",\"url\":\"https://support.avito.ru/sections/200645056\"}}},\"text\":\"Вы публикуете объявление и данные в нём, чтобы их мог посмотреть кто угодно в интернете. Вы также соглашаетесь {{userAgreement}}.\"}}},\"value\":{}}],\"rootNavigation\":{},\"shouldSaveDraft\":true,\"steps\":[{\"config\":{},\"fields\":[100004,178152],\"id\":11430554,\"title\":\"Внешний вид\",\"type\":\"params\",\"hash\":\"41373579d641ab2f8de6b1d0ce80e439\"},{\"config\":{},\"fields\":[100001,11430559],\"id\":11430557,\"title\":\"Укажите название\",\"type\":\"params\",\"hash\":\"260f5ac517bcfe5da1fd345ac4053490\"},{\"config\":{},\"fields\":[],\"id\":11430560,\"subtitle\":\"Важно выбрать верную категорию для вашего товара\",\"title\":\"Выберите категорию\",\"type\":\"suggestCategory\",\"hash\":\"d985e07d3882c2792c340624b9598912\"},{\"config\":{},\"fields\":[],\"id\":11430561,\"shouldSkip\":true,\"skipOnBackwards\":true,\"subtype\":\"suggest\",\"title\":\"Пре саджест каталожных параметров\",\"type\":\"request\",\"hash\":\"992bb2a5f40298fa8f43a7acbabb5bcd\"},{\"config\":{},\"fields\":[],\"id\":11430562,\"skipOnBackwards\":true,\"subtype\":\"steps\",\"title\":\"Загрузка шагов\",\"type\":\"request\",\"hash\":\"f4d25f3922caf28c63b10a4574aee54b\"},{\"config\":{\"request\":{\"params\":{\"params\":{\"flow\":\"add\"},\"path\":\"/cpt-b2c-goods/restrictions/check\",\"prefix\":\"web\"},\"type\":\"custom\"}},\"fields\":[],\"id\":15392724,\"skipOnBackwards\":true,\"title\":\"Блокировка подачи для нарушивших условия обеления\",\"type\":\"restriction\",\"hash\":\"db2d4794a1c6d9be826683076d839f7a\"},{\"config\":{\"request\":{\"params\":{\"params\":{\"flow\":\"add\"},\"path\":\"/whitewashing/restrictions/check\",\"prefix\":\"web\"},\"type\":\"custom\"}},\"fields\":[],\"id\":15620338,\"skipOnBackwards\":true,\"title\":\"Блокировка подачи для нарушивших условия обеления v2\",\"type\":\"restriction\",\"hash\":\"a537cc36b5c6aba4a4cc95c2c2d397d8\"},{\"config\":{\"isContinueButtonHidden\":true},\"fields\":[110385],\"id\":11430566,\"title\":\"Состояние\",\"type\":\"select\",\"hash\":\"43f5b0bda7dab328edcbf3e5f0bcece2\"},{\"config\":{\"isContinueButtonHidden\":true},\"fields\":[2826],\"id\":11430568,\"title\":\"Вид объявления\",\"type\":\"select\",\"hash\":\"9c4cd6f1de1297ed87fff56b87fa6e5a\"},{\"config\":{},\"fields\":[],\"id\":14890795,\"skipOnBackwards\":true,\"subtype\":\"steps\",\"title\":\"Загрузка шагов 1\",\"type\":\"request\",\"hash\":\"d0aad0aec46a050d1933ed3eb298e689\"},{\"config\":{},\"fields\":[],\"id\":13299528,\"shouldSkip\":false,\"skipOnBackwards\":true,\"subtype\":\"suggest\",\"title\":\"Саджест каталожных