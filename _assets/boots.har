едложение.\",\"passOnMatch\":false,\"regexp\":\"^(прода(ю|м|жа|(е|ё)т(ь)?ся))$\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:sale\"}},{\"type\":\"length\",\"value\":{\"max\":50,\"maxV2\":50,\"message\":\"Длина названия не может превышать 50 символов\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"Не упоминайте Instagram или Facebook. Они принадлежат Meta Platforms Inc., чья деятельность запрещена в России.\",\"passOnMatch\":false,\"regexp\":\"(^|[^a-zA-Z0-9а-яА-Я])(?:[mм][eе][tт][аa@еуы]|f[aа@]ceb[o0][o0][kк]|ф[еэ]йсбук|[iи][nн][sс][tт][aа@][gг][rр][aа@][mм]|[iи][nн][sс][тt])($|[^a-zA-Z0-9а-яА-Я])\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:meta\"}},{\"type\":\"regexp\",\"value\":{\"tag\":\"100001:text:regexp\",\"message\":\"Не упоминайте Instagram или Facebook. Они принадлежат Meta Platforms Inc., чья деятельность запрещена в России.\",\"regexp\":\"(^|[^a-zA-Z0-9а-яА-Я])(?:[mм][eе][tт][аa@еуы]|f[aа@]ceb[o0][o0][kк]|ф[еэ]йсбук|[iи][nн][sс][tт][aа@][gг][rр][aа@][mм]|[iи][nн][sс][тt])($|[^a-zA-Z0-9а-яА-Я])\",\"passOnMatch\":false,\"severity\":\"warningOnFlowFinish\"}},{\"type\":\"required\",\"value\":{\"tag\":\"100001:text:required\",\"message\":\"Укажите значение параметра\",\"passOnMatch\":false,\"severity\":\"error\"}}],\"value\":\"Кроссовки мужские\",\"updatesForm\":false},{\"id\":185281,\"title\":\"Вещи пакетом\",\"displayTitle\":\"Нет\",\"type\":\"select\",\"immutable\":false,\"widget\":{\"type\":\"hidden\"},\"isRange\":false,\"value\":\"3342684\",\"values\":[{\"id\":\"3342680\",\"title\":\"Мешок\"},{\"id\":\"3342681\",\"title\":\"Коробка\"},{\"id\":\"3342682\",\"title\":\"Пакет\"},{\"id\":\"3342683\",\"title\":\"Лот\"},{\"id\":\"3342684\",\"title\":\"Нет\"}],\"hasSuggest\":false,\"updatesForm\":false},{\"id\":191573,\"title\":\"1-click подача\",\"type\":\"select\",\"immutable\":false,\"widget\":{\"type\":\"hidden\"},\"isRange\":false,\"values\":[{\"id\":\"1\",\"title\":\"Да\"},{\"id\":\"0\",\"title\":\"Нет\"}],\"hasSuggest\":false,\"update