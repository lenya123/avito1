в\"}],\"hasSuggest\":false,\"updatesForm\":true},{\"id\":196273,\"title\":\"Оптовые продажи предикт\",\"type\":\"select\",\"immutable\":false,\"widget\":{\"type\":\"hidden\"},\"isRange\":false,\"values\":[{\"id\":\"1\",\"title\":\"Да\"},{\"id\":\"0\",\"title\":\"Нет\"}],\"hasSuggest\":false,\"updatesForm\":false},{\"id\":100001,\"title\":\"Название объявления\",\"type\":\"char\",\"required\":true,\"immutable\":false,\"widget\":{\"type\":\"input\",\"config\":{\"constraints\":[{\"type\":\"regexp\",\"value\":{\"message\":\"Не пишите в названии цену, для этого есть отдельное поле.\",\"passOnMatch\":false,\"regexp\":\"(^|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)[0-9]{3,}\\\\s*[\\\\$\\\\€\\\\¥]|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+(руб|рублей|₽)($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:price_app\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим правилам нельзя размещать объявления о покупке. Ищите интересующие вас товары в поиске.\",\"passOnMatch\":false,\"regexp\":\"(^|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)куплю($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:purchase\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим правилам нельзя писать в названии: скидка, акция, дёшево, срочно и т. д. Привлекайте внимание к объявлению подробным описанием и чёткими фотографиями.\",\"passOnMatch\":false,\"regexp\":\"(^|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)(срочно|внимание|даром|торопитесь|выгодно)($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:attention\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим правилам нельзя указывать телефоны, ссылки и эл. почту в названии.\",\"passOnMatch\":false,\"regexp\":\"(^|[^\\\\d-])((8|\\\\+?7)[ .-]?)?\\\\(?9\\\\d{2}\\\\)?[ .-]?([ .-]?\\\\d[ .-]?){7}\",\"severity\":\"warningOnFlowFinish\",\"tag\":\"title:phone\"}},{\"type\":\"regexp\",\"value\":{\"message\":\"По нашим п