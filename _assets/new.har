":\"1\",\"title\":\"Да\"},{\"id\":\"0\",\"title\":\"Нет\"}],\"hasSuggest\":false,\"updatesForm\":false},{\"id\":192386,\"title\":\"Доступность просто скидки\",\"displayTitle\":\"Да\",\"type\":\"select\",\"immutable\":false,\"widget\":{\"type\":\"hidden\"},\"isRange\":false,\"value\":\"1\",\"values\":[{\"id\":\"1\",\"title\":\"Да\"},{\"id\":\"0\",\"title\":\"Нет\"}],\"hasSuggest\":false,\"updatesForm\":true},{\"id\":15475473,\"type\":\"slot\",\"label\":\"Рекомендованная цена\",\"widget\":{\"type\":\"universalBeduin\",\"config\":{\"contentUrl\":\"api/1/imv/goods/publish/slot\"}},\"value\":{}},{\"id\":13213605,\"type\":\"slot\",\"label\":\"Характеристики\",\"widget\":{\"type\":\"sectionSeparator\",\"config\":{\"title\":\"Характеристики\"}},\"value\":{}},{\"id\":13213737,\"type\":\"slot\",\"label\":\"inAppCallsDevices\",\"widget\":{\"type\":\"inAppCallsDevices\",\"config\":{\"iacDevices\":[],\"iacForPro\":false,\"iacProUser\":false}},\"value\":{\"iacDevices\":[\"2CE28A1D-3647-4484-AFAA-71F3A4E4C0B5\"],\"iacProChosen\":false}},{\"id\":13213589,\"type\":\"slot\",\"label\":\"Несколько штук в наличии\",\"widget\":{\"type\":\"stockManagement\",\"config\":{\"inputField\":{\"constraints\":{\"max\":{\"message\":\"Укажите число до 1 000 000\",\"value\":999999}},\"displaying\":{\"hideTitle\":true,\"postfix\":\"шт.\"},\"hint\":\"Количество можно не указывать\",\"label\":\"Количество\",\"placeholder\":\"Количество\",\"type\":\"quantity\"},\"size\":\"m\",\"switcherField\":{\"label\":\"Несколько штук в наличии\",\"linkTitle\":\"Как это работает\",\"tooltip\":{\"content\":[{\"content\":\"Покупатели увидят, что вы продаёте несколько штук, упаковок или других единиц товара — и смогут купить больше одной.\",\"title\":\"В объявлении появится отметка о количестве\"},{\"content\":\"Если она будет доступна и вы её включите, то сразу несколько человек смогут оформить заказ.\\n\\n А если укажете точное количество товара, мы поможем не набрать лишних заказов: когда запасы закончатся, снимем объявление с публикации или уберём из него кнопки «Купить с доставкой» и «Добавить в корзину».\",\"title\":\"Как это работает с Авито Доставкой\"}],\"title\":\"В объявлении появится отметка о количестве\"}}}},\"value\":{\"stockMultiple\":false,\"stockQuantity\":1}},{\"id\":13213750,\"type\":\"slot\",\"label\":\"autoPublish\",\"widget\":{\"type\":\"autoPublish\",\"config\":{\"field\":{\"header\":\"Автопубликация\",\"id\":\"autoPublish\",\"subtitle\":{\"attributes\":{\"detailsLink\":{\"type\":\"deepLink\",\"value\":{\"title\":\"Подробнее\",\"uri\":\"ru.avito://1/detailssheet/show?contentJson=%7B%22title%22%3A%22%D0%90%D0%B2%D1%82%D0%BE%D0%BF%D1%83%D0%B1%D0%BB%D0%B8%D0%BA%D0%B0%D1%86%D0%B8%D1%8F%22%2C%22description%22%3A%7B%22text%22%3A%22%D0%9A%D0%BE%D0%B3%D0%B4%D0%B0%20%D1%81%D1%80%D0%BE%D0%BA%20%D1%80%D0%B0%D0%B7%D0%BC%D0%B5%D1%89%D0%B5%D0%BD%D0%B8%D1%8F%20%D0%B7%D0%B0%D0%BA%D0%BE%D0%BD%D1%87%D0%B8%D1%82%D1%81%D1%8F%2C%20%D0%BE%D0%B1%D1%8A%D1%8F%D0%B2%D0%BB%D0%B5%D0%BD%D0%B8%D0%B5%20%D0%BE%D0%BF%D1%83%D0%B1%D0%BB%D0%B8%D0%BA%D1%83%D0%B5%D1%82%D1%81%D1%8F%20%D0%B7%D0%B0%D0%BD%D0%BE%D0%B2%D0%BE%20%D0%B8%20%D0%BF%D0%BE%D0%B4%D0%BD%D0%B8%D0%BC%D0%B5%D1%82%D1%81%D1%8F%20%D0%B2%20%D1%80%D0%B5%D0%B7%D1%83%D0%BB%D1%8C%D1%82%D0%B0%D1%82%D0%B0%D1%85%20%D0%BF%D0%BE%D0%B8%D1%81%D0%BA%D0%B0.%20%D0%A7%D1%82%D0%BE%D0%B1%D1%8B%20%D0%B0%D0%B2%D1%82%D0%BE%D0%BF%D1%83%D0%B1%D0%BB%D0%B8%D0%BA%D0%B0%D1%86%D0%B8%D1%8F%20%D0%BF%D1%80%D0%BE%D0%B8%D0%B7%D0%BE%D1%88%D0%BB%D0%B0%2C%20%D1%83%20%D0%B2%D0%B0%D1%81%20%D0%B4%D0%BE%D0%BB%D0%B6%D0%BD%D1%8B%20%D0%BE%D1%81%D1%82%D0%B0%D1%82%D1%8C%D1%81%D1%8F%20%D0%B1%D0%B5%D1%81%D0%BF%D0%BB%D0%B0%D1%82%D0%BD%D1%8B%D0%B5%20%D1%80%D0%B0%D0%B7%D0%BC%D0%B5%D1%89%D0%B5%D0%BD%D0%B8%D1%8F.%5Cn%D0%9E%D0%B1%D1%8A%D1%8F%D0%B2%D0%BB%D0%B5%D0%BD%D0%B8%D0%B5%20%D0%B1%D1%83%D0%B4%D0%B5%D1%82%20%D1%80%D0%B0%D0%B7%D0%BC%D0%B5%D1%89%D0%B0%D1%82%D1%8C%D1%81%D1%8F%20%D0%B7%D0%B0%D0%BD%D0%BE%D0%B2%D0%BE%20%D0%B2%20%D1%82%D0%B5%D1%87%D0%B5%D0%BD%D0%B8%D0%B5%20%D0%BF%D0%BE%D0