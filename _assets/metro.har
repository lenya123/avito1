            "text": "{\"fields\":[{\"entityType\":\"slot\",\"id\":15687923,\"label\":\"restrictionInfoV2\",\"sorting\":2,\"stepId\":15687920,\"value\":{},\"widget\":{\"config\":{\"editMode\":false,\"publishMode\":true,\"request\":{\"params\":{\"path\":\"/whitewashing/restrictions/check\",\"version\":1},\"type\":\"custom\"},\"shouldBlockOnError\":false},\"type\":\"restrictionInfo\"}},{\"entityType\":\"slot\",\"id\":15389272,\"label\":\"restrictionInfo\",\"sorting\":4,\"stepId\":15389271,\"value\":{},\"widget\":{\"config\":{\"editMode\":false,\"publishMode\":true,\"request\":{\"params\":{\"path\":\"/cpt-b2c-goods/restrictions/check\",\"version\":1},\"type\":\"custom\"},\"shouldBlockOnError\":false},\"type\":\"restrictionInfo\"}},{\"dataType\":\"integer\",\"displayTitle\":\"Мужская обувь\",\"enabled\":true,\"entityType\":\"field\",\"hasSuggest\":false,\"id\":175,\"label\":\"Вид одежды\",\"multiple\":false,\"name\":\"params[175]\",\"slug\":\"vid_odezhdy\",\"sorting\":6,\"stepId\":11426110,\"type\":\"enumerable\",\"updatesForm\":true,\"validation\":[{\"message\":\"Выберите значение из списка\",\"rule\":\"required\",\"severity\":\"error\"}],\"value\":2804317,\"values\":[{\"label\":\"Женская одежда\",\"value\":747},{\"label\":\"Женская обувь\",\"value\":2804318},{\"label\":\"Мужская одежда\",\"value\":748},{\"label\":\"Мужская обувь\",\"value\":2804317},{\"label\":\"Сумки, рюкзаки и чемоданы\",\"value\":2804316},{\"label\":\"Аксессуары\",\"value\":749}],\"widget\":{\"config\":{\"size\":\"m\"},\"type\":\"hidden\"}},{\"dataType\":\"string\",\"enabled\":true,\"entityType\":\"field\",\"hasSuggest\":false,\"help\":\"Например, «Комбинезон зимний Reima 104 см» или «Apple Watch 3 стальной ремешок»\",\"id\":100001,\"label\":\"Название объявления\",\"multiple\":false,\"name\":\"title\",\"placeholder\":\"\",\"slug\":\"title\",\"sorting\":8,\"stepId\":11426112,\"type\":\"text\",\"updatesForm\":false,\"validation\":[{\"message\":\"Не пишите в названии цену, для этого есть отдельное поле.\",\"regexNegative\":\"(^|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)[0-9]{3,}\\\\s*[\\\\$\\\\€\\\\¥]|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+(руб|рублей|₽)($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"regexPositive\":\"сертификат|купон\",\"rule\":\"regex\",\"severity\":\"warning\",\"slug\":\"price\"},{\"message\":\"По нашим правилам нельзя размещать объявления о покупке. Ищите интересующие вас товары в поиске.\",\"regexNegative\":\"(^|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)куплю($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"rule\":\"regex\",\"severity\":\"warning\",\"slug\":\"purchase\"},{\"message\":\"По нашим правилам нельзя писать в названии: скидка, акция, дёшево, срочно и т. д. Привлекайте внимание к объявлению подробным описанием и чёткими фотографиями.\",\"regexNegative\":\"(^|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)(срочно|внимание|даром|торопитесь|выгодно)($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"rule\":\"regex\",\"severity\":\"warning\",\"slug\":\"attention\"},{\"message\":\"Перенесите номер телефона из описания в поле «Телефон» на следующем экране. Вы можете продолжить публикацию, если считаете, что предупреждение ошибочно.\",\"regexNegative\":\"(^|[^\\\\d-])((8|\\\\+?7)[ .-]?)?\\\\(?9\\\\d{2}\\\\)?[ .-]?([ .-]?\\\\d[ .-]?){7}\",\"rule\":\"regex\",\"severity\":\"warning\",\"slug\":\"phone\"},{\"message\":\"Не указывайте ссылки на сторонние ресурсы в описании. Объявление может быть отклонено. Опишите свойства объявления текстом.\",\"regexNegative\":\"(((ht|f)tp(s?))\\\\:\\\\/\\\\/|www\\\\.|file\\\\:\\\\/\\\\/)+[\\\\w\\\\.\\\\-]+\\\\.[a-z]{2,4}(\\\\/[\\\\w\\\\/\\\\.\\\\-\\\\.\\\\?\\\\,\\\\'\\\\/\\\\\\\\+\\u0026amp;%\\\\$#\\\\=~]*|($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+))\",\"rule\":\"regex\",\"severity\":\"warning\",\"slug\":\"link\"},{\"message\":\"Не указывайте эл. почту в описании. Объявление может быть отклонено. Для связи с продавцом используется телефон или сервис сообщений.\",\"regexNegative\":\"[a-z]+[\\\\.\\\\-a-z0-9_]*[ ]*@[ ]*[\\\\.\\\\-a-z0-9_]*[ ]*\\\\.[ ]*(?:ru|com|org|ua|uk|net|cn|nl|eu|info|biz|kz|bu|su|de|fr|lt|cz)($|[\\\\s\\\\n\\\\r\\\\t.,'\\\"\\\\+!?-]+)\",\"rule\":\"regex\",\"severity\":\"warning\",\"slug\":\"email\"},{\"message\":\"Не пишите в названии слово «продам». Вместо этого укажите точное название, чтобы покупателям было проще найти ваше предложение.\",\"regexNegative\":\"^(прода(ю|м|жа|(е|ё)т(ь)?ся))$\",\"rule\":\"regex\",\"severity\":\"warning\",\"slug\":\"sale\"},{\"message\":\"Не упоминайте Instagram или Facebook. Они принадлежат Meta Platforms Inc., чья деятельность запрещена в России.\",\"regexNegative\":\"\\\\b(?:[mм]e[tт][a@еуы]|f[a@]ceb[o0][o0]k\\\\w{0,5}|ф[еэ]йсбук\\\\w{0,5}|[iи][nн][sс][tт][a@][gг][rр][a@][mм]\\\\w{0,5}|[iи][nн][sс][тt]\\\\w?)\\\\b\",\"rule\":\"regex\",\"severity\":\"warning\",\"slug\":\"meta_platforms_inc\"},{\"message\":\"Можно ввести до 50 символов\",\"regexPositive\":\"^.{0,50}$\",\"rule\":\"regex\",\"severity\":\"warning\",\"slug\":\"length_warning\"},{\"message\":\"Можно ввести до 50 символов\",\"regexPositive\":\"^.{0,50}$\",\"rule\":\"regex\",\"severity\":\"error\",\"slug\":\"length_error\"},{\"message\":\"Укажите значение параметра\",\"rule\":\"required\",\"severity\":\"error\"}],\"value\":\"кроссовки\",\"widget\":{\"config\":{\"constraints\":[{\"type\":\"length\",\"value\":{\"max\":50,\"maxV2\":50,\"message\":\"Длина названия не может превышать 50 символов\"}}],\"size\":\"m\",\"suggestType\":\"bubbles\",\"suggestUrl\":\"/web/1/publish/title/suggest\",\"updatesForm\":true},\"type\":\"title\"}},{\"dataType\":\"integer\",\"enabled\":true,\"entityType\":\"field\",\"hasSuggest\":false,\"id\":2826,\"label\":\"Вид объявления\",\"multiple\":false,\"name\":\"params[2826]\",\"slug\":\"type_of_trade\",\"sorting\":9,\"stepId\":11426112,\"type\":\"enumerable\",\"updatesForm\":true,\"validation\":[{\"message\":\"Выберите значение из списка\",\"rule\":\"required\",\"severity\":\"error\"}],\"values\":[{\"label\":\"Продаю своё\",\"value\":20029},{\"label\":\"Товар п