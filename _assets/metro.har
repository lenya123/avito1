%D0%94%D0%BE%D0%B1%D0%B0%D0%B2%D0%B8%D1%82%D1%8C%5Cu00A0%D0%B2%5Cu00A0%D0%BA%D0%BE%D1%80%D0%B7%D0%B8%D0%BD%D1%83%C2%BB.%22%0A%20%20%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%20%20%7D%0A%20%20%20%20%7D%0A%20%20%5D%0A%7D%0A\"}}},\"text\":\"{{link}}\"},\"type\":\"number\",\"width\":4},\"type\":\"stockManagement\"}},{\"dataType\":\"integer\",\"enabled\":true,\"entityType\":\"field\",\"hasSuggest\":false,\"id\":100006,\"label\":\"Местоположение (locationId)\",\"multiple\":false,\"name\":\"locationId\",\"slug\":\"locationId\",\"sorting\":52,\"stepId\":11426139,\"type\":\"text\",\"updatesForm\":false,\"widget\":{\"config\":{\"contactWays\":[\"phoneAndMessenger\",\"onlyPhone\",\"onlyMessenger\"],\"size\":\"m\"},\"type\":\"locationId\"}},{\"dataType\":\"string\",\"enabled\":true,\"entityType\":\"field\",\"hasSuggest\":false,\"help\":\"Точный адрес поможет привлечь заинтересованных покупателей\",\"id\":2861,\"label\":\"Место сделки\",\"multiple\":false,\"name\":\"params[2861]\",\"placeholder\":\"Начните вводить адрес\",\"slug\":\"address\",\"sorting\":54,\"stepId\":11426146,\"type\":\"text\",\"updatesForm\":false,\"validation\":[{\"maxValue\":256,\"message\":\"Значение должно быть до 256 символов\",\"minValue\":0,\"rule\":\"range\",\"severity\":\"error\"},{\"message\":\"Введите значение параметра\",\"rule\":\"required\",\"severity\":\"error\"}],\"widget\":{\"config\":{\"flowType\":\"historicalSuggest\",\"hidePinWhenAddressEmpty\":true,\"hint\":{\"attributedText\":{\"text\":\"Укажите реальный адрес, где покупатель может купить или получить товар\"}},\"hintHelp\":{\"content\":\"Покупателям будет проще сделать выбор и они смогут найти ваше объявление при поиске по радиусу, району или метро.\\nЭто не помешает вашему предложению появиться в результатах поиска по городу, региону или всей России.\",\"header\":\"Почему лучше указывать реальный адрес?\"},\"layout\":\"narrow\",\"size\":\"m\",\"successAddTooltip\":{\"text\":\"Адрес сохранён в профиле в разделе «Адреса для объявлений».\\nВы можете его использовать в других объявлениях.\"},\"unactiveHelp\":{\"text\":\"Адрес нельзя использовать в объявлении. Замените его или добавьте новый\",\"tooltip\":{\"header\":\"Адрес не получится использовать в объявлении\",\"text\":\"Почему так могло произойти:\\n— Адрес заполнен по старым правилам.\\n— Адрес был удалён из профиля.\\n— У вас отключена подписка на бизнес-инструменты.\\n\\nЗамените адрес в объявлении или добавьте новый — всё сработает. \"}},\"updatesForm\":true,\"width\":9},\"type\":\"address\"}},{\"entityType\":\"slot\",\"id\":11426151,\"label\":\"Авито Доставка\",\"sorting\":58,\"stepId\":11426148,\"value\":{},\"widget\":{\"config\":{\"size\":\"m\",\"text\":{\"attributes\":{},\"text\":\"Выберите, как покупатели смогут заказать ваш товар. Это безопасно: вам не нужно платить за отправку, а если с посылкой что-то случится в пути, мы возместим ущерб.\",\"type\":\"attributed_text\"},\"title\":\"Доставка партнёрами Авито\",\"toggles\":{\"courier\":{\"changeEvent\":{\"eid\":5163,\"version\":1},\"submitKey\":\"deliveryCourier\",\"subtitle\":\"Яндекс Доставка, Достависта\",\"title\":\"Курьером\"},\"postamat\":{\"changeEvent\":{\"eid\":5555,\"version\":0},\"submitKey\":\"deliveryPostamat\",\"subtitle\":\"5Post, Халва Экспресс\",\"title\":\"В постамат\"},\"pvz\":{\"changeEvent\":{\"eid\":5152,\"version\":1},\"submitKey\":\"deliveryPvz\",\"subtitle\":\"Почта России, СДЭК, Авито, DPD, Яндекс Доставка\",\"title\":\"В пункт выдачи\"}}},\"type\":\"deliveryToggles\"}},{\"entityType\":\"slot\",\"id\":11426152,\"label\":\"Субсидирование доставки\",\"sorting\":60,\"stepId\":11426148,\"value\":{},\"widget\":{\"config\":{},\"type\":\"deliverySubsidies\"}},{\"entityType\":\"slot\",\"id\":13947928,\"label\":\"Условия возврата (редизайн)\",\"sorting\":61,\"stepId\":11426148,\"value\":{},\"widget\":{\"config\":{},\"type\":\"deliveryReturnPolicyBlock\"}},{\"entityType\":\"slot\",\"id\":11426154,\"label\":\"Комиссия за доставку\",\"sorting\"