{
  "name": "avito-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:push": "npx supabase db push --linked",
    "db:migrate": "npx supabase db push --linked",
    "db:gen-types": "npx supabase gen types typescript --linked > src/types/database.generated.ts",
    "worker": "npx tsx scripts/worker.ts",
    "worker:dev": "npx tsx watch scripts/worker.ts",
    "dev:bots": "npx tsx watch scripts/dev-bots.ts",
    "dev:all": "concurrently --kill-others -n web,worker,bots -c blue,yellow,green \"npm run dev\" \"npm run worker:dev\" \"npm run dev:bots\"",
    "dev:restart": "bash scripts/dev-restart.sh",
    "webhooks:set": "npx tsx scripts/set-webhooks.ts",
    "test:rls:migrate": "node scripts/apply-test-migrations.mjs",
    "test:rls": "npm run test:rls:migrate && vitest run --config vitest.config.ts",
    "test:rls:watch": "npm run test:rls:migrate && vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.10.0",
    "@mmote/niimbluelib": "^0.0.1-alpha.38",
    "@sentry/nextjs": "^10.50.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/react-query": "^5.90.16",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.66.5",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "focus-trap-react": "^12.0.0",
    "framer-motion": "^11.18.2",
    "grammy": "^1.39.2",
    "ioredis": "^5.9.2",
    "jose": "^6.2.2",
    "jsbarcode": "^3.12.3",
    "jszip": "^3.10.1",
    "next": "14.2.35",
    "openai": "^6.17.0",
    "pdf-to-img": "^5.0.0",
    "proxy-chain": "^2.5.7",
    "puppeteer": "^24.37.5",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sharp": "^0.33.5",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.71.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "undici": "^7.22.0",
    "uuid": "^13.0.0",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8",
    "postgres": "^3.4.9",
    "prettier": "^3.7.4",
    "supabase": "^2.72.4",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
