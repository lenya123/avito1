# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session (JWT signing)
# Сгенерировать: openssl rand -hex 32
SESSION_SECRET=your-session-secret-32-bytes-hex

# Avito-интеграция (Этап 9). Пока false — воркер не будет стартовать Avito-джобы
# (sync-avito-data, sync-avito-orders, AI-агент продаж). Поднять в true когда
# Stage 9 разработчик включит интеграцию.
AVITO_ENABLED=false

# Telegram Bots
#
# Режим работы ботов:
#   - dev: long polling через scripts/dev-bots.ts (без публичного URL).
#     Запускается как часть `npm run dev:all`.
#   - prod: webhook'и через /api/telegram/<bot> (требует публичный URL +
#     разовую установку через `npm run webhooks:set <base-url>`).
#
# При деплое prod рекомендуется завести отдельный комплект bot-токенов
# в BotFather (4 шт) — Telegram допускает только один режим на токен
# одновременно, поэтому dev-сессия с polling кратковременно отрывает
# webhook у prod-бота на том же токене.
TELEGRAM_CUSTOMER_BOT_TOKEN=your-customer-bot-token
TELEGRAM_SHIPPER_BOT_TOKEN=your-shipper-bot-token
TELEGRAM_OWNER_BOT_TOKEN=your-owner-bot-token
TELEGRAM_PARTNER_BOT_TOKEN=your-partner-bot-token
# Бот AI-фото объявлений (@krossovodaiphotosbot) — сюда шлются AI-обложки на «Четко/Переделай».
TELEGRAM_AIPHOTOS_BOT_TOKEN=your-aiphotos-bot-token
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
# Клиентская группа: customer-bot постит карточки заказов и возвратов
# (клиенты видят знакомое брендовое имя). Супергруппа с топиками
# («Заказы», «Возвраты»). Topic-id'ы — в business_settings.
# Customer-bot должен быть админом этой группы (Manage Topics + Send Messages).
TELEGRAM_ORDERS_GROUP_ID=your-orders-group-id
# Приватная группа «ЧЕКИ»: только владелец + помощники. Без топиков.
# Customer-bot постит сюда фото-чеков (используем тот же бот что для
# клиентской группы — owner-bot намеренно нигде не светится).
# Customer-bot должен быть админом (Send Messages).
TELEGRAM_RECEIPTS_GROUP_ID=your-receipts-group-id
OWNER_TELEGRAM_ID=your-owner-telegram-id
# Username partner-бота (без @) — используется для генерации invite-ссылок
# на /owner/partners. Должен совпадать с TELEGRAM_PARTNER_BOT_TOKEN.
NEXT_PUBLIC_PARTNER_BOT_USERNAME=your_partner_bot

# Redis (BullMQ Jobs)
# Local: redis://localhost:6379
# Upstash: rediss://default:xxx@xxx.upstash.io:6379
REDIS_URL=redis://localhost:6379

# Префикс очередей BullMQ — изоляция сред на общем Redis (локалка vs прод).
# Локально задавай уникальный (напр. bull-localdev); прод — оставь пустым (дефолт bull).
# BULLMQ_PREFIX=bull-localdev

# Воркер внутри Next-процесса (instrumentation). false — если рядом запущен
# отдельный воркер (npm run worker / dev:all → worker:dev), иначе джобы
# обрабатываются дважды. По умолчанию (не задано) — включён.
# WORKER_IN_WEB=false

# Jobs API Security (для production)
# Сгенерировать: openssl rand -hex 32
JOBS_API_SECRET=your-secret-key-for-jobs-api

# AI (OpenAI)
# Используется для AI-помощника + веб-поиск через Responses API,
# а также генерации названия/описания объявлений, выбора категории и адреса.
OPENAI_API_KEY=your-openai-api-key
# Опционально: прокси-эндпоинт OpenAI для обхода РФ-блокировки (proxy-api.ru и т.п.)
# OPENAI_BASE_URL=

# AI (Google Gemini «Nano Banana», gemini-2.5-flash-image)
# Генерация обложек и AI-фото объявлений (фон/фотозона/личность).
# Без ключа генерация фото = pass-through (берётся исходное живое фото).
GEMINI_API_KEY=your-gemini-api-key
# Опционально переопределить модель:
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# RuCaptcha (решение GeeTest-капчи при HTTP-логине в Avito)
RUCAPTCHA_API_KEY=your-rucaptcha-key

# Delivery Tracking (Track.global API через RapidAPI)
# Подписка: https://rapidapi.com → Track.global
# Два ключа: RapidAPI key + Bearer token от Track.global
TRACK_GLOBAL_RAPIDAPI_KEY=your-rapidapi-key
TRACK_GLOBAL_BEARER_TOKEN=your-track-global-bearer-token

# Sentry (мониторинг, optional)
# Один DSN на инсталляцию оптовика. TENANT_ID / NEXT_PUBLIC_TENANT_ID тегируют
# события, чтобы в одном Sentry-проекте различать отправителей.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
TENANT_ID=
NEXT_PUBLIC_TENANT_ID=
# Server-side (sentry.server.config.ts, sentry.edge.config.ts):
SENTRY_ENV=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Client-side (sentry.client.config.ts):
NEXT_PUBLIC_SENTRY_ENV=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Source-maps upload (используются только при CI-билде):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# RLS-тесты — не сюда, в .env.test:
# TEST_DATABASE_URL=postgres://...session-pooler-supabase-url...
